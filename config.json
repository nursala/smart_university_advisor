{
    "listeners": [
        {
            "address": "0.0.0.0",
            "port": 8080,
            "https": false
        }
    ],
    "app": {
        "number_of_threads": 4,
        "enable_session": false,
        "document_root": "./public",
        "use_implicit_page": false,
        "log": {
            "log_level": "INFO"
        },
        "run_as_daemon": false,
        "handle_sig_term": true,
        "float_precision_in_json": {
            "precision": 15,
            "precision_type": "significant"
        }
    }
}
